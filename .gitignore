# Настройки конкретного хранилища — там лежит ключ пользователя открытым текстом.
data.json

# Сборка. main.js собирается из src/ (build.sh) и уезжает в релиз;
# в репозитории ему делать нечего — иначе он тихо расходится с исходником.
main.js

node_modules/

